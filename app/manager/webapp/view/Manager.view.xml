<mvc:View
    controllerName="manager.controller.Manager"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    displayBlock="true">

    <Page
        id="managerPage"
        title="Manager Dashboard"
        showNavButton="false">

        <!-- ==================================================
             PAGE HEADER ACTIONS
             ================================================== -->

        <headerContent>

            <Button
                id="refreshDashboardButton"
                text="Refresh"
                icon="sap-icon://refresh"
                tooltip="Refresh dashboard data"
                press=".onRefresh" />

        </headerContent>

        <content>

            <VBox
                id="mainDashboardContainer"
                class="sapUiMediumMargin">

                <!-- ==================================================
                     DASHBOARD TITLE
                     ================================================== -->

                <Title
                    id="dashboardMainTitle"
                    text="Professional Services Automation Dashboard"
                    level="H1"
                    class="sapUiSmallMarginBottom" />

                <Text
                    id="dashboardDescription"
                    text="Monitor projects, budgets, timesheet approvals and invoices."
                    class="sapUiSmallMarginBottom" />

                <!-- ==================================================
                     KPI OVERVIEW
                     ================================================== -->

                <Toolbar
                    id="managerOverviewToolbar"
                    class="sapUiSmallMarginTop">

                    <Title
                        id="managerOverviewTitle"
                        text="Manager Overview"
                        level="H2" />

                </Toolbar>

                <HBox
                    id="kpiCardsContainer"
                    wrap="Wrap"
                    alignItems="Start"
                    justifyContent="Start"
                    class="sapUiSmallMarginTop sapUiSmallMarginBottom">

                    <!-- Active Projects -->

                    <GenericTile
                        id="activeProjectsTile"
                        header="Active Projects"
                        subheader="Currently active"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                        press=".onProjects">

                        <TileContent
                            id="activeProjectsTileContent">

                            <NumericContent
                                id="activeProjectsNumericContent"
                                value="{dashboard>/activeProjects}"
                                valueColor="Good"
                                icon="sap-icon://business-objects-experience"
                                withMargin="false" />

                        </TileContent>

                    </GenericTile>

                    <!-- Pending Approvals -->

                    <GenericTile
                        id="pendingApprovalsTile"
                        header="Pending Approvals"
                        subheader="Submitted timesheets"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                        press=".onTimesheets">

                        <TileContent
                            id="pendingApprovalsTileContent">

                            <NumericContent
                                id="pendingApprovalsNumericContent"
                                value="{dashboard>/pendingApprovals}"
                                valueColor="Critical"
                                icon="sap-icon://pending"
                                withMargin="false" />

                        </TileContent>

                    </GenericTile>

                    <!-- Paid Invoices -->

                    <GenericTile
                        id="paidInvoicesTile"
                        header="Paid Invoices"
                        subheader="Completed payments"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                        press=".onInvoices">

                        <TileContent
                            id="paidInvoicesTileContent">

                            <NumericContent
                                id="paidInvoicesNumericContent"
                                value="{dashboard>/paidInvoices}"
                                valueColor="Good"
                                icon="sap-icon://money-bills"
                                withMargin="false" />

                        </TileContent>

                    </GenericTile>

                    <!-- At-Risk Budgets -->

                    <GenericTile
                        id="atRiskBudgetsTile"
                        header="At-Risk Budgets"
                        subheader="Requires attention"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                        press=".onProjects">

                        <TileContent
                            id="atRiskBudgetsTileContent">

                            <NumericContent
                                id="atRiskBudgetsNumericContent"
                                value="{dashboard>/atRiskBudgets}"
                                valueColor="Error"
                                icon="sap-icon://alert"
                                withMargin="false" />

                        </TileContent>

                    </GenericTile>

                </HBox>

                <!-- ==================================================
                     QUICK NAVIGATION
                     ================================================== -->

                <Toolbar
                    id="quickNavigationToolbar"
                    class="sapUiSmallMarginTop">

                    <Title
                        id="quickNavigationTitle"
                        text="Quick Navigation"
                        level="H2" />

                </Toolbar>

                <HBox
                    id="quickNavigationButtons"
                    wrap="Wrap"
                    class="sapUiSmallMarginTop sapUiSmallMarginBottom">

                    <Button
                        id="navigateProjectsButton"
                        text="Projects"
                        icon="sap-icon://business-objects-experience"
                        type="Emphasized"
                        press=".onProjects"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom" />

                    <Button
                        id="navigateTimesheetsButton"
                        text="Timesheets"
                        icon="sap-icon://timesheet"
                        press=".onTimesheets"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom" />

                    <Button
                        id="navigateInvoicesButton"
                        text="Invoices"
                        icon="sap-icon://sales-order"
                        press=".onInvoices"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom" />

                </HBox>

                <!-- ==================================================
                     PENDING TIMESHEET APPROVALS
                     ================================================== -->

                <Toolbar
                    id="pendingTimesheetsToolbar"
                    class="sapUiSmallMarginTop">

                    <Title
                        id="pendingTimesheetsTitle"
                        text="Pending Timesheet Approvals"
                        level="H2" />

                    <ToolbarSpacer
                        id="pendingTimesheetsToolbarSpacer" />

                    <ObjectStatus
                        id="pendingTimesheetsStatus"
                        text="{= ${dashboard>/pendingApprovals} + ' pending' }"
                        state="Warning"
                        icon="sap-icon://pending" />

                </Toolbar>

                <Table
                    id="pendingApprovalsTable"
                    items="{dashboard>/approvals}"
                    growing="true"
                    growingThreshold="10"
                    growingScrollToLoad="false"
                    sticky="ColumnHeaders,HeaderToolbar"
                    noDataText="No submitted timesheets are awaiting approval"
                    class="sapUiSmallMarginBottom">

                    <columns>

                        <Column
                            id="approvalEmployeeColumn"
                            width="16rem">

                            <Text
                                id="approvalEmployeeColumnText"
                                text="Employee" />

                        </Column>

                        <Column
                            id="approvalWeekStartColumn"
                            width="10rem">

                            <Text
                                id="approvalWeekStartColumnText"
                                text="Week Start" />

                        </Column>

                        <Column
                            id="approvalWeekEndColumn"
                            width="10rem">

                            <Text
                                id="approvalWeekEndColumnText"
                                text="Week End" />

                        </Column>

                        <Column
                            id="approvalStatusColumn"
                            width="9rem">

                            <Text
                                id="approvalStatusColumnText"
                                text="Status" />

                        </Column>

                        <Column
                            id="approvalHoursColumn"
                            width="8rem"
                            hAlign="End">

                            <Text
                                id="approvalHoursColumnText"
                                text="Hours" />

                        </Column>

                        <Column
                            id="approvalActionsColumn"
                            width="16rem"
                            hAlign="Center">

                            <Text
                                id="approvalActionsColumnText"
                                text="Manager Actions" />

                        </Column>

                    </columns>

                    <items>

                        <ColumnListItem
                            id="pendingApprovalTableRow"
                            type="Inactive"
                            vAlign="Middle">

                            <cells>

                                <ObjectIdentifier
                                    id="pendingApprovalEmployee"
                                    title="{dashboard>employee}"
                                    text="{dashboard>ID}" />

                                <Text
                                    id="pendingApprovalWeekStart"
                                    text="{dashboard>weekStartDate}" />

                                <Text
                                    id="pendingApprovalWeekEnd"
                                    text="{dashboard>weekEndDate}" />

                                <ObjectStatus
                                    id="pendingApprovalStatus"
                                    text="{dashboard>status}"
                                    state="Warning"
                                    icon="sap-icon://pending" />

                                <ObjectNumber
                                    id="pendingApprovalHours"
                                    number="{dashboard>hours}"
                                    unit="hrs" />

                                <HBox
                                    id="pendingApprovalActionButtons"
                                    wrap="Wrap"
                                    justifyContent="Center">

                                    <Button
                                        id="approveTimesheetButton"
                                        text="Approve"
                                        icon="sap-icon://accept"
                                        type="Accept"
                                        tooltip="Approve submitted timesheet"
                                        press=".onApproveTimesheet"
                                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom" />

                                    <Button
                                        id="rejectTimesheetButton"
                                        text="Reject"
                                        icon="sap-icon://decline"
                                        type="Reject"
                                        tooltip="Reject timesheet with a mandatory reason"
                                        press=".onRejectTimesheet"
                                        class="sapUiTinyMarginBottom" />

                                </HBox>

                            </cells>

                        </ColumnListItem>

                    </items>

                </Table>

                <!-- ==================================================
                     MANAGED PROJECTS AND PROJECT ACTIONS
                     ================================================== -->

                <Toolbar
                    id="managedProjectsToolbar"
                    class="sapUiSmallMarginTop">

                    <Title
                        id="managedProjectsTitle"
                        text="Managed Projects"
                        level="H2" />

                    <ToolbarSpacer
                        id="managedProjectsToolbarSpacer" />

                    <ObjectStatus
                        id="managedProjectsStatus"
                        text="{= ${dashboard>/projects}.length + ' projects' }"
                        state="Information"
                        icon="sap-icon://project-definition-triangle-2" />

                </Toolbar>

                <Table
                    id="managedProjectsTable"
                    items="{dashboard>/projects}"
                    growing="true"
                    growingThreshold="10"
                    growingScrollToLoad="false"
                    sticky="ColumnHeaders,HeaderToolbar"
                    noDataText="No managed projects are available"
                    class="sapUiSmallMarginBottom">

                    <columns>

                        <Column
                            id="managedProjectCodeColumn"
                            width="10rem">

                            <Text
                                id="managedProjectCodeColumnText"
                                text="Project Code" />

                        </Column>

                        <Column
                            id="managedProjectNameColumn"
                            width="18rem">

                            <Text
                                id="managedProjectNameColumnText"
                                text="Project Name" />

                        </Column>

                        <Column
                            id="managedProjectStatusColumn"
                            width="9rem">

                            <Text
                                id="managedProjectStatusColumnText"
                                text="Status" />

                        </Column>

                        <Column
                            id="managedProjectHoursColumn"
                            width="10rem"
                            hAlign="End">

                            <Text
                                id="managedProjectHoursColumnText"
                                text="Consumed Hours" />

                        </Column>

                        <Column
                            id="managedProjectActionsColumn"
                            width="23rem"
                            hAlign="Center">

                            <Text
                                id="managedProjectActionsColumnText"
                                text="Project Actions" />

                        </Column>

                    </columns>

                    <items>

                        <ColumnListItem
                            id="managedProjectTableRow"
                            type="Inactive"
                            vAlign="Middle">

                            <cells>

                                <ObjectIdentifier
                                    id="managedProjectCode"
                                    title="{dashboard>projectCode}"
                                    text="{dashboard>ID}" />

                                <Text
                                    id="managedProjectName"
                                    text="{dashboard>projectName}" />

                                <ObjectStatus
                                    id="managedProjectStatus"
                                    text="{dashboard>status}"
                                    state="Information" />

                                <ObjectNumber
                                    id="managedProjectConsumedHours"
                                    number="{dashboard>consumedHours}"
                                    unit="hrs" />

                                <HBox
                                    id="managedProjectActionButtons"
                                    wrap="Wrap"
                                    justifyContent="Center">

                                    <Button
                                        id="recalculateBudgetButton"
                                        text="Recalculate Budget"
                                        icon="sap-icon://simulate"
                                        tooltip="Recalculate consumed and remaining budget"
                                        press=".onRecalculateBudget"
                                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom" />

                                    <Button
                                        id="generateInvoiceButton"
                                        text="Generate Invoice"
                                        icon="sap-icon://create-form"
                                        type="Emphasized"
                                        tooltip="Generate a draft invoice for the project"
                                        press=".onGenerateInvoice"
                                        class="sapUiTinyMarginBottom" />

                                </HBox>

                            </cells>

                        </ColumnListItem>

                    </items>

                </Table>

                <!-- ==================================================
                     PROJECT STATUS OVERVIEW
                     ================================================== -->

                <Toolbar
                    id="projectStatusOverviewToolbar"
                    class="sapUiSmallMarginTop">

                    <Title
                        id="projectStatusOverviewTitle"
                        text="Project Status Overview"
                        level="H2" />

                </Toolbar>

                <List
                    id="projectStatusOverviewList"
                    items="{dashboard>/projectStatus}"
                    noDataText="No project status data is available"
                    class="sapUiSmallMarginBottom">

                    <items>

                        <StandardListItem
                            id="projectStatusOverviewItem"
                            title="{dashboard>status}"
                            description="Number of projects"
                            info="{dashboard>count}"
                            infoState="Information"
                            icon="sap-icon://project-definition-triangle-2"
                            type="Inactive" />

                    </items>

                </List>

            </VBox>

        </content>

    </Page>

</mvc:View>